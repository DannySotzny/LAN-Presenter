@page "/login"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@inject BeamerPresenter.Application.IPresenterSettingsService SettingsService
@inject NavigationManager Navigation
<section class="card narrow"><h1>Anmeldung</h1>@if (_isUnconfigured) { <p>Der Passwortschutz wurde noch nicht eingerichtet. Öffne die Einstellungen in der Desktop-App und setze ein Passwort.</p> } else { @if (HasError) { <p class="error">Das Passwort ist nicht korrekt.</p> } <form method="post" action="/account/login"><input type="hidden" name="returnUrl" value="/" /><label for="password">Passwort</label><input id="password" name="password" type="password" autocomplete="current-password" required autofocus /><button type="submit">Anmelden</button></form> }</section>
@code { private bool _isUnconfigured; private bool HasError => Navigation.ToAbsoluteUri(Navigation.Uri).Query.Contains("error=1", StringComparison.Ordinal); protected override async Task OnInitializedAsync() => _isUnconfigured = !await SettingsService.HasWebPasswordAsync(); }
