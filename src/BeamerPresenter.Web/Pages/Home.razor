@page "/"
@using MudBlazor
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject BeamerPresenter.Application.IMediaLibraryService MediaLibraryService
@inject BeamerPresenter.Application.PlaybackController Playback

<MudStack Spacing="4">
    <MudPaper Elevation="2" Class="pa-6 hero-panel">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <div><MudText Typo="Typo.h4">Steuerzentrale</MudText><MudText Typo="Typo.body1" Color="Color.Secondary">Presenter und Medien für die nächste LAN-Party.</MudText></div>
            <MudChip T="string" Color="Color.Info" Variant="Variant.Filled" Icon="@Icons.Material.Filled.PauseCircle">@Playback.State</MudChip>
        </MudStack>
    </MudPaper>

    <MudGrid Spacing="4">
        <MudItem xs="12" md="5"><MudPaper Elevation="2" Class="pa-6 full-height"><MudStack Spacing="3"><MudIcon Icon="@Icons.Material.Filled.CloudUpload" Color="Color.Primary" Size="Size.Large" /><MudText Typo="Typo.h5">Neues Video hochladen</MudText><MudText Typo="Typo.body2" Color="Color.Secondary">Das Video wird in den Desktop-konfigurierten Videoordner geschrieben.</MudText><form method="post" enctype="multipart/form-data" action="/api/videos/upload"><input class="upload-input" type="file" name="video" accept="video/mp4,video/x-matroska,video/webm,video/quicktime,video/x-msvideo" required /><MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Upload">Video hochladen</MudButton></form></MudStack></MudPaper></MudItem>
        <MudItem xs="12" md="7"><MudPaper Elevation="2" Class="pa-6 full-height"><MudStack Spacing="2"><MudText Typo="Typo.h5">Videobibliothek</MudText>@if (_videos.Count == 0) { <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Noch keine Videos erfasst.</MudAlert> } else { <MudList T="string" Dense="true">@foreach (var video in _videos) { <MudListItem T="string" Icon="@Icons.Material.Filled.Movie"><MudText>@video.FileName</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">@FormatSize(video.FileSize)</MudText></MudListItem> }</MudList> }</MudStack></MudPaper></MudItem>
    </MudGrid>
    <form method="post" action="/account/logout"><MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Logout">Abmelden</MudButton></form>
</MudStack>

@code {
    private IReadOnlyList<BeamerPresenter.Domain.VideoAsset> _videos = [];
    protected override async Task OnInitializedAsync() => _videos = await MediaLibraryService.GetAllAsync();
    private static string FormatSize(long bytes) => $"{bytes / 1024d / 1024d:0.0} MB";
}
