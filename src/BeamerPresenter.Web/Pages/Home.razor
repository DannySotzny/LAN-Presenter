@page "/"
@using BeamerPresenter.Domain
@using MudBlazor
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject BeamerPresenter.Application.IMediaLibraryService MediaLibraryService
@inject BeamerPresenter.Application.PlaybackQueueService PlaybackQueue
@inject BeamerPresenter.Application.INewsService NewsService
@inject BeamerPresenter.Application.PlaybackController Playback
@inject BeamerPresenter.Web.PresenterDashboardService Dashboard

<MudStack Spacing="4">
    <MudPaper Elevation="0" Class="hero-panel pa-7 pa-sm-9">
        <MudGrid Class="hero-grid">
            <MudItem xs="12" md="8">
                <MudText Typo="Typo.overline" Class="hero-kicker">LAN PARTY CONTROL DECK</MudText>
                <MudText Typo="Typo.h3" Class="hero-title">Bereit für den nächsten Clip.</MudText>
                <MudText Typo="Typo.body1" Class="hero-copy">Lokale Medien prüfen, neue Videos einsammeln und den Beamer im Blick behalten.</MudText>
            </MudItem>
            <MudItem xs="12" md="4">
                <div class="presenter-state-card">
                    <MudIcon Icon="@PresenterIcon" Size="Size.Large" />
                    <div>
                        <MudText Typo="Typo.caption" Class="state-label">PRESENTER</MudText>
                        <MudText Typo="Typo.h5" id="dashboard-presenter-state">@(_status?.PresenterState ?? Playback.State.ToString())</MudText>
                        <MudText Typo="Typo.caption" id="dashboard-browser-state">Browser: @(_status?.BrowserConnected == true ? "Verbunden" : "Getrennt")</MudText>
                    </div>
                </div>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Elevation="0" Class="content-panel pa-6 live-status-panel">
        <MudGrid Spacing="3" Class="live-status-grid">
            <MudItem xs="12" md="5">
                <MudText Typo="Typo.overline" Class="live-status-label">AKTUELLE WIEDERGABE</MudText>
                <MudText Typo="Typo.h5" id="dashboard-current-title">@(_status?.CurrentTitle ?? "–")</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" id="dashboard-position">@FormatPlaybackPosition(_status?.Position, _status?.Duration)</MudText>
            </MudItem>
            <MudItem xs="6" md="2">
                <MudText Typo="Typo.caption" Color="Color.Secondary">FFPROBE</MudText>
                <div class="health-value" id="dashboard-ffprobe">@(_status?.FfprobeAvailable == true ? "OK" : "Nicht verfügbar")</div>
            </MudItem>
            <MudItem xs="6" md="2">
                <MudText Typo="Typo.caption" Color="Color.Secondary">MEDIA SCANNER</MudText>
                <div class="health-value" id="dashboard-scanner">@(_status?.MediaScannerRunning == true ? "Läuft" : "Bereit")</div>
            </MudItem>
            <MudItem xs="12" md="3">
                <div class="presenter-controls" aria-label="Presenter steuern">
                    <form method="post" action="/api/presenter/pause"><button type="submit">Pause</button></form>
                    <form method="post" action="/api/presenter/activate"><button type="submit" class="primary">Resume</button></form>
                    <form method="post" action="/api/presenter/hide"><button type="submit">Hide</button></form>
                    <form method="post" action="/api/presenter/stop"><button type="submit" class="danger">Stop</button></form>
                </div>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (UploadResult == "success")
    {
        <MudAlert Severity="Severity.Success" Variant="Variant.Filled">Das Video wurde gespeichert und für die Medienanalyse eingereiht.</MudAlert>
    }
    else if (UploadResult == "error")
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">@(!string.IsNullOrWhiteSpace(UploadMessage) ? UploadMessage : "Das Video konnte nicht hochgeladen werden.")</MudAlert>
    }
    @if (MediaResult is "enabled" or "disabled" or "reanalyzing")
    {
        <MudAlert Severity="Severity.Success" Variant="Variant.Filled">Die Videoeinstellung wurde aktualisiert.</MudAlert>
    }
    else if (MediaResult == "error")
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">@(!string.IsNullOrWhiteSpace(MediaMessage) ? MediaMessage : "Die Videoaktion ist fehlgeschlagen.")</MudAlert>
    }
    @if (PresenterResult == "error")
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">@(!string.IsNullOrWhiteSpace(PresenterMessage) ? PresenterMessage : "Der Presenter-Befehl ist fehlgeschlagen.")</MudAlert>
    }
    @if (QueueResult == "success")
    {
        <MudAlert Severity="Severity.Success" Variant="Variant.Filled">Die Wiedergabe-Queue wurde aktualisiert.</MudAlert>
    }
    @if (HistoryResult == "cleared")
    {
        <MudAlert Severity="Severity.Success" Variant="Variant.Filled">Die Wiedergabehistorie wurde zurückgesetzt.</MudAlert>
    }
    else if (QueueResult == "error")
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">@(!string.IsNullOrWhiteSpace(QueueMessage) ? QueueMessage : "Die Queue-Aktion ist fehlgeschlagen.")</MudAlert>
    }
    @if (YouTubeResult == "success")
    {
        <MudAlert Severity="Severity.Success" Variant="Variant.Filled">Das YouTube-Video wurde normalisiert und in die Queue aufgenommen.</MudAlert>
    }
    else if (YouTubeResult == "error")
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">@(!string.IsNullOrWhiteSpace(YouTubeMessage) ? YouTubeMessage : "Der YouTube-Link konnte nicht eingereiht werden.")</MudAlert>
    }
    @if (NewsResult is "created" or "shown" or "stopped" or "deleted")
    {
        <MudAlert Severity="Severity.Success" Variant="Variant.Filled">Die News-Aktion wurde ausgeführt.</MudAlert>
    }
    else if (NewsResult == "error")
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">@(!string.IsNullOrWhiteSpace(NewsMessage) ? NewsMessage : "Die News-Aktion ist fehlgeschlagen.")</MudAlert>
    }

    <MudGrid Spacing="3">
        <MudItem xs="6" md="3">
            <MudPaper Elevation="0" Class="metric-card">
                <MudIcon Icon="@Icons.Material.Filled.VideoLibrary" Color="Color.Primary" />
                <MudText Typo="Typo.h4">@_videos.Count</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Videos gesamt</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" md="3">
            <MudPaper Elevation="0" Class="metric-card">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" />
                <MudText Typo="Typo.h4">@ReadyCount</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Abspielbereit</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" md="3">
            <MudPaper Elevation="0" Class="metric-card">
                <MudIcon Icon="@Icons.Material.Filled.HourglassTop" Color="Color.Info" />
                <MudText Typo="Typo.h4">@PendingCount</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">In Analyse</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" md="3">
            <MudPaper Elevation="0" Class="metric-card">
                <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Color="Color.Warning" />
                <MudText Typo="Typo.h4">@ProblemCount</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Prüfen</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudPaper Elevation="0" Class="content-panel pa-6 youtube-panel">
        <MudGrid Spacing="3">
            <MudItem xs="12" md="4">
                <div class="panel-icon youtube-icon"><MudIcon Icon="@Icons.Custom.Brands.YouTube" Size="Size.Large" /></div>
                <MudText Typo="Typo.h5" Class="mt-3">YouTube einreihen</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">Watch-, Kurz- und Shorts-Links werden normalisiert. Bei Netz- oder Playerfehlern läuft die lokale Queue weiter.</MudText>
            </MudItem>
            <MudItem xs="12" md="8">
                <form method="post" class="youtube-form">
                    <label class="youtube-url-field">YouTube URL<input name="url" type="url" placeholder="https://youtu.be/…" required /></label>
                    <div class="youtube-time-grid">
                        <label>Eigener Start <span>(optional)</span><input name="start" type="text" placeholder="01:20:00" /></label>
                        <label>Eigene Dauer <span>(optional)</span><input name="duration" type="text" placeholder="00:08:00" /></label>
                        <label>Maximale Laufzeit<input name="maximumDuration" type="text" value="00:10:00" required /></label>
                    </div>
                    <div class="youtube-actions">
                        <button type="submit" formaction="/api/youtube/next">Als Nächstes</button>
                        <button type="submit" formaction="/api/youtube/now" class="primary">Sofort</button>
                    </div>
                </form>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Elevation="0" Class="content-panel pa-6">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-4">
            <div>
                <MudText Typo="Typo.h5">Wiedergabe-Queue</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Aktueller Clip und die nächsten @_queue.Count(entry => entry.Status == QueueEntryStatus.Pending) Einträge</MudText>
            </div>
            <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary" Icon="@Icons.Material.Filled.QueueMusic">@_queue.Count Einträge</MudChip>
            <form method="post" action="/api/queue/regenerate">
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh">Queue neu generieren</MudButton>
            </form>
        </MudStack>
        @if (_queue.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Die Queue wird aufgefüllt, sobald analysierte Videos verfügbar sind.</MudAlert>
        }
        else
        {
            <MudTable T="QueueEntry" Items="@QueueDisplay" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Class="queue-table">
                <HeaderContent>
                    <MudTh>Position</MudTh>
                    <MudTh>Video</MudTh>
                    <MudTh>Segment</MudTh>
                    <MudTh>Herkunft</MudTh>
                    <MudTh>Aktionen</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Position">
                        <MudChip T="string" Size="Size.Small" Color="@(context.Status == QueueEntryStatus.Playing ? Color.Success : Color.Default)" Variant="Variant.Outlined">
                            @(context.Status == QueueEntryStatus.Playing ? "NOW" : context.SortOrder.ToString(System.Globalization.CultureInfo.InvariantCulture))
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Video">@GetQueueVideoName(context)</MudTd>
                    <MudTd DataLabel="Segment">@FormatSegment(context.StartPosition, context.EndPosition)</MudTd>
                    <MudTd DataLabel="Herkunft">@FormatOrigin(context.Origin)</MudTd>
                    <MudTd DataLabel="Aktionen">
                        @if (context.Status == QueueEntryStatus.Pending)
                        {
                            <div class="queue-row-actions">
                                <form method="post" action="/api/queue/move-up"><input type="hidden" name="id" value="@context.Id" /><button type="submit" title="Nach oben">↑</button></form>
                                <form method="post" action="/api/queue/move-down"><input type="hidden" name="id" value="@context.Id" /><button type="submit" title="Nach unten">↓</button></form>
                                <form method="post" action="/api/queue/remove"><input type="hidden" name="id" value="@context.Id" /><button type="submit" class="danger">Entfernen</button></form>
                            </div>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>

    <MudPaper Elevation="0" Class="content-panel pa-6">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-4">
            <div>
                <MudText Typo="Typo.h5">Wiedergabehistorie</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Die letzten tatsächlich gestarteten lokalen und YouTube-Segmente</MudText>
            </div>
            <form method="post" action="/api/history/clear">
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.DeleteSweep">Historie zurücksetzen</MudButton>
            </form>
        </MudStack>
        @if (_history.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Noch keine Wiedergaben gespeichert.</MudAlert>
        }
        else
        {
            <MudTable T="PlaybackHistory" Items="@_history" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Class="history-table">
                <HeaderContent>
                    <MudTh>Zeit</MudTh>
                    <MudTh>Quelle</MudTh>
                    <MudTh>Video</MudTh>
                    <MudTh>Segment</MudTh>
                    <MudTh>Status</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Zeit">@context.StartedUtc.ToLocalTime().ToString("g")</MudTd>
                    <MudTd DataLabel="Quelle">@(context.SourceType == MediaSourceType.Local ? "Local" : "YouTube")</MudTd>
                    <MudTd DataLabel="Video">@GetHistoryVideoName(context)</MudTd>
                    <MudTd DataLabel="Segment">@FormatSegment(context.ActualStart ?? context.PlannedStart, context.ActualEnd ?? context.PlannedEnd)</MudTd>
                    <MudTd DataLabel="Status">@FormatHistoryStatus(context)</MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>

    <MudPaper Elevation="0" Class="content-panel pa-6 news-panel">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-4">
            <div>
                <MudText Typo="Typo.h5">News &amp; Einblendungen</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Ticker, 50:50-Split-Screen oder priorisierte Fullscreen-Meldung</MudText>
            </div>
            <form method="post" action="/api/news/stop">
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.StopCircle">Aktuelle News beenden</MudButton>
            </form>
        </MudStack>
        <MudGrid Spacing="4">
            <MudItem xs="12" lg="5">
                <form method="post" action="/api/news/create" class="news-form">
                    <label>Titel<input name="title" maxlength="200" required /></label>
                    <label>Text<textarea name="text" rows="4" maxlength="4000" required></textarea></label>
                    <div class="news-form-grid">
                        <label>Modus
                            <select name="mode">
                                <option value="Ticker">Ticker</option>
                                <option value="SplitScreen">Split-Screen 50:50</option>
                                <option value="Fullscreen">Fullscreen</option>
                            </select>
                        </label>
                        <label>Dauer<input name="duration" type="text" value="00:05:00" /></label>
                        <label>Priorität<input name="priority" type="number" value="0" min="-1000" max="1000" /></label>
                    </div>
                    <label class="news-checkbox"><input name="permanent" type="checkbox" value="true" /> Permanent anzeigen</label>
                    <div class="news-form-grid news-schedule-grid">
                        <label>Gültig ab <span>(optional)</span><input name="validFrom" type="datetime-local" /></label>
                        <label>Gültig bis <span>(optional)</span><input name="validUntil" type="datetime-local" /></label>
                    </div>
                    <button type="submit" class="news-create-button">News speichern</button>
                </form>
            </MudItem>
            <MudItem xs="12" lg="7">
                @if (_news.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Noch keine News gespeichert.</MudAlert>
                }
                else
                {
                    <MudTable T="NewsItem" Items="@_news" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Class="news-table">
                        <HeaderContent>
                            <MudTh>News</MudTh>
                            <MudTh>Modus</MudTh>
                            <MudTh>Laufzeit</MudTh>
                            <MudTh>Aktion</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="News">
                                <MudText Typo="Typo.body2">@context.Title</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Text</MudText>
                            </MudTd>
                            <MudTd DataLabel="Modus"><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@FormatNewsMode(context.Mode)</MudChip></MudTd>
                            <MudTd DataLabel="Laufzeit">@(context.Permanent ? "Permanent" : FormatDuration(context.Duration))</MudTd>
                            <MudTd DataLabel="Aktion">
                                <div class="news-row-actions">
                                    <form method="post" action="/api/news/show"><input type="hidden" name="id" value="@context.Id" /><button type="submit">Jetzt anzeigen</button></form>
                                    <form method="post" action="/api/news/delete"><input type="hidden" name="id" value="@context.Id" /><button type="submit" class="danger">Löschen</button></form>
                                </div>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudGrid Spacing="4">
        <MudItem xs="12" lg="4">
            <MudPaper Elevation="0" Class="content-panel pa-6 full-height">
                <div class="panel-icon"><MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Large" /></div>
                <MudText Typo="Typo.h5" Class="mt-4">Video hinzufügen</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2 mb-5">Die Datei landet im ersten aktiven Videoordner. Analyse und Status aktualisieren sich automatisch.</MudText>
                <form method="post" enctype="multipart/form-data" action="/api/videos/upload">
                    <input type="hidden" name="returnUrl" value="/" />
                    <label class="upload-dropzone" for="video-upload">
                        <MudIcon Icon="@Icons.Material.Filled.AddToDrive" Size="Size.Large" />
                        <span>Datei auswählen</span>
                        <small>MP4, MKV, WebM, MOV oder AVI</small>
                    </label>
                    <input class="visually-hidden-file" id="video-upload" type="file" name="video" accept="video/mp4,video/x-matroska,video/webm,video/quicktime,video/x-msvideo" required />
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large" StartIcon="@Icons.Material.Filled.Upload" Class="mt-4">Hochladen</MudButton>
                </form>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" lg="8">
            <MudPaper Elevation="0" Class="content-panel pa-6 full-height">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-4">
                    <div>
                        <MudText Typo="Typo.h5">Videobibliothek</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@FilteredVideos.Count von @_videos.Count Einträgen</MudText>
                    </div>
                    <form method="get" action="/" class="library-search-form">
                        <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" />
                        <input name="q" value="@Search" type="search" class="library-search" placeholder="Datei, Codec oder Container" aria-label="Videobibliothek durchsuchen" />
                        <button type="submit">Suchen</button>
                    </form>
                </MudStack>

                @if (FilteredVideos.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">@(string.IsNullOrWhiteSpace(Search) ? "Noch keine Videos erfasst." : "Keine Videos passen zu dieser Suche.")</MudAlert>
                }
                else
                {
                    <MudTable T="VideoAsset" Items="@FilteredVideos" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm" Class="media-table">
                        <HeaderContent>
                            <MudTh>Video</MudTh>
                            <MudTh>Status</MudTh>
                            <MudTh>Format</MudTh>
                            <MudTh>Dauer</MudTh>
                            <MudTh>Größe</MudTh>
                            <MudTh>Aktion</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Video">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <div class="media-file-icon"><MudIcon Icon="@Icons.Material.Filled.Movie" Size="Size.Small" /></div>
                                    <div class="media-name-cell">
                                        <MudText Typo="Typo.body2">@context.FileName</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@(context.IsAvailable ? FormatResolution(context) : "Datei nicht verfügbar")</MudText>
                                    </div>
                                </MudStack>
                            </MudTd>
                            <MudTd DataLabel="Status">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@GetStatusColor(context)" Icon="@GetStatusIcon(context)">@GetStatusText(context)</MudChip>
                            </MudTd>
                            <MudTd DataLabel="Format"><span class="codec-label">@FormatCodec(context)</span></MudTd>
                            <MudTd DataLabel="Dauer">@FormatDuration(context.Duration)</MudTd>
                            <MudTd DataLabel="Größe">@FormatSize(context.FileSize)</MudTd>
                            <MudTd DataLabel="Aktion">
                                <div class="media-actions">
                                    @if (IsPlayable(context))
                                    {
                                        <form method="post" action="/api/queue/next">
                                            <input type="hidden" name="mediaId" value="@context.Id" />
                                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.SkipNext">Als Nächstes</MudButton>
                                        </form>
                                        <form method="post" action="/api/queue/now">
                                            <input type="hidden" name="mediaId" value="@context.Id" />
                                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.PlayArrow">Sofort</MudButton>
                                        </form>
                                        @if (context.Duration > TimeSpan.FromMinutes(10))
                                        {
                                            <details class="segment-picker">
                                                <summary>Segment wählen</summary>
                                                <form method="post" class="segment-form">
                                                    <input type="hidden" name="mediaId" value="@context.Id" />
                                                    <label>Start<input name="start" type="text" placeholder="01:20:00" required /></label>
                                                    <label>Dauer<input name="duration" type="text" placeholder="00:08:00" required /></label>
                                                    <div>
                                                        <button type="submit" formaction="/api/queue/next">Als Nächstes</button>
                                                        <button type="submit" formaction="/api/queue/now">Sofort</button>
                                                    </div>
                                                </form>
                                            </details>
                                        }
                                    }
                                    <form method="post" action="/api/videos/set-enabled">
                                        <input type="hidden" name="id" value="@context.Id" />
                                        <input type="hidden" name="enabled" value="@(!context.Enabled)" />
                                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text" Color="@(context.Enabled ? Color.Warning : Color.Success)" Size="Size.Small" StartIcon="@(context.Enabled ? Icons.Material.Filled.Block : Icons.Material.Filled.CheckCircle)">@(context.Enabled ? "Deaktivieren" : "Aktivieren")</MudButton>
                                    </form>
                                    @if (context.IsAvailable)
                                    {
                                        <form method="post" action="/api/videos/reanalyze">
                                            <input type="hidden" name="id" value="@context.Id" />
                                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text" Color="Color.Secondary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Refresh">Neu analysieren</MudButton>
                                        </form>
                                    }
                                </div>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>

    <form method="post" action="/account/logout" class="logout-form">
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Logout">Abmelden</MudButton>
    </form>
</MudStack>

<script src="_content/BeamerPresenter.Web/js/dashboard.js"></script>

@code {
    private IReadOnlyList<VideoAsset> _videos = [];
    private IReadOnlyList<QueueEntry> _queue = [];
    private IReadOnlyList<NewsItem> _news = [];
    private IReadOnlyList<PlaybackHistory> _history = [];
    private PresenterDashboardSnapshot? _status;

    [Microsoft.AspNetCore.Components.SupplyParameterFromQuery(Name = "q")]
    public string? Search { get; set; }

    [Microsoft.AspNetCore.Components.SupplyParameterFromQuery(Name = "upload")]
    public string? UploadResult { get; set; }

    [Microsoft.AspNetCore.Components.SupplyParameterFromQuery(Name = "message")]
    public string? UploadMessage { get; set; }

    [Microsoft.AspNetCore.Components.SupplyParameterFromQuery(Name = "queue")]
    public string? QueueResult { get; set; }

    [Microsoft.AspNetCore.Components.SupplyParameterFromQuery(Name = "message")]
    public string? QueueMessage { get; set; }

    [Microsoft.AspNetCore.Components.SupplyParameterFromQuery(Name = "youtube")]
    public string? YouTubeResult { get; set; }

    [Microsoft.AspNetCore.Components.SupplyParameterFromQuery(Name = "message")]
    public string? YouTubeMessage { get; set; }

    [Microsoft.AspNetCore.Components.SupplyParameterFromQuery(Name = "news")]
    public string? NewsResult { get; set; }

    [Microsoft.AspNetCore.Components.SupplyParameterFromQuery(Name = "message")]
    public string? NewsMessage { get; set; }

    [Microsoft.AspNetCore.Components.SupplyParameterFromQuery(Name = "presenter")]
    public string? PresenterResult { get; set; }

    [Microsoft.AspNetCore.Components.SupplyParameterFromQuery(Name = "message")]
    public string? PresenterMessage { get; set; }

    [Microsoft.AspNetCore.Components.SupplyParameterFromQuery(Name = "history")]
    public string? HistoryResult { get; set; }

    [Microsoft.AspNetCore.Components.SupplyParameterFromQuery(Name = "media")]
    public string? MediaResult { get; set; }

    [Microsoft.AspNetCore.Components.SupplyParameterFromQuery(Name = "message")]
    public string? MediaMessage { get; set; }

    private string PresenterIcon => Playback.State == PresenterState.Active ? Icons.Material.Filled.PlayCircle : Icons.Material.Filled.PauseCircle;
    private int ReadyCount => _videos.Count(video => video.Enabled && video.IsAvailable && video.PlaybackStatus == MediaPlaybackStatus.Supported);
    private int PendingCount => _videos.Count(video => video.Enabled && video.IsAvailable && video.ProbeStatus == MediaProbeStatus.Unknown);
    private int ProblemCount => _videos.Count(video => video.Enabled && (!video.IsAvailable || video.ProbeStatus is MediaProbeStatus.Invalid or MediaProbeStatus.Missing || video.PlaybackStatus == MediaPlaybackStatus.Unsupported));
    private IReadOnlyList<VideoAsset> FilteredVideos => string.IsNullOrWhiteSpace(Search)
        ? _videos
        : _videos.Where(MatchesSearch).ToList();
    private IReadOnlyList<QueueEntry> QueueDisplay =>
        _queue.Where(entry => entry.Status == QueueEntryStatus.Playing)
            .Concat(_queue.Where(entry => entry.Status == QueueEntryStatus.Pending).Take(10))
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        var videosTask = MediaLibraryService.GetAllAsync();
        var queueTask = PlaybackQueue.GetQueueAsync();
        var newsTask = NewsService.GetAllAsync();
        var historyTask = PlaybackQueue.GetHistoryAsync();
        var statusTask = Dashboard.GetAsync();
        await Task.WhenAll(videosTask, queueTask, newsTask, historyTask, statusTask);
        _videos = await videosTask;
        _queue = await queueTask;
        _news = await newsTask;
        _history = (await historyTask).Take(50).ToList();
        _status = await statusTask;
    }

    private bool MatchesSearch(VideoAsset video)
    {
        var search = Search!.Trim();
        return video.FileName.Contains(search, StringComparison.OrdinalIgnoreCase)
            || (video.VideoCodec?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false)
            || (video.AudioCodec?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false)
            || (video.Container?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private static Color GetStatusColor(VideoAsset video) => video switch
    {
        { Enabled: false } => Color.Secondary,
        { IsAvailable: false } => Color.Error,
        { ProbeStatus: MediaProbeStatus.Invalid or MediaProbeStatus.Missing } => Color.Error,
        { PlaybackStatus: MediaPlaybackStatus.Unsupported } => Color.Warning,
        { ProbeStatus: MediaProbeStatus.Valid, PlaybackStatus: MediaPlaybackStatus.Supported } => Color.Success,
        _ => Color.Info
    };

    private static string GetStatusIcon(VideoAsset video) => video switch
    {
        { Enabled: false } => Icons.Material.Filled.Block,
        { IsAvailable: false } => Icons.Material.Filled.LinkOff,
        { ProbeStatus: MediaProbeStatus.Invalid or MediaProbeStatus.Missing } => Icons.Material.Filled.Error,
        { PlaybackStatus: MediaPlaybackStatus.Unsupported } => Icons.Material.Filled.Warning,
        { ProbeStatus: MediaProbeStatus.Valid, PlaybackStatus: MediaPlaybackStatus.Supported } => Icons.Material.Filled.CheckCircle,
        _ => Icons.Material.Filled.HourglassTop
    };

    private static string GetStatusText(VideoAsset video) => video switch
    {
        { Enabled: false } => "Deaktiviert",
        { IsAvailable: false } => "Fehlt",
        { ProbeStatus: MediaProbeStatus.Invalid } => "Fehlerhaft",
        { PlaybackStatus: MediaPlaybackStatus.Unsupported } => "Inkompatibel",
        { ProbeStatus: MediaProbeStatus.Valid, PlaybackStatus: MediaPlaybackStatus.Supported } => "Bereit",
        _ => "Analyse"
    };

    private static string FormatResolution(VideoAsset video) => video.VideoWidth is > 0 && video.VideoHeight is > 0
        ? $"{video.VideoWidth} × {video.VideoHeight}"
        : "Auflösung wird ermittelt";

    private static string FormatCodec(VideoAsset video)
    {
        var codecs = new[] { video.VideoCodec, video.AudioCodec }.Where(value => !string.IsNullOrWhiteSpace(value));
        var codecText = string.Join(" / ", codecs);
        return !string.IsNullOrWhiteSpace(codecText) ? codecText.ToUpperInvariant() : "–";
    }

    private static string FormatDuration(TimeSpan? duration) => duration is null
        ? "–"
        : duration.Value.TotalHours >= 1 ? duration.Value.ToString(@"h\:mm\:ss") : duration.Value.ToString(@"m\:ss");

    private static string FormatPlaybackPosition(TimeSpan? position, TimeSpan? duration) =>
        $"{FormatClock(position)} / {FormatClock(duration)}";

    private static string FormatClock(TimeSpan? value) => value?.ToString(@"hh\:mm\:ss") ?? "--:--:--";

    private static string FormatSize(long bytes) => bytes >= 1024L * 1024 * 1024
        ? $"{bytes / 1024d / 1024d / 1024d:0.0} GB"
        : $"{bytes / 1024d / 1024d:0.0} MB";

    private static bool IsPlayable(VideoAsset video) =>
        video.Enabled && video.IsAvailable && video.Duration > TimeSpan.Zero && video.PlaybackStatus == MediaPlaybackStatus.Supported;

    private string GetQueueVideoName(QueueEntry entry) => entry.SourceType switch
    {
        MediaSourceType.Local when entry.MediaId is int mediaId =>
            _videos.FirstOrDefault(video => video.Id == mediaId)?.FileName ?? $"Video #{mediaId}",
        MediaSourceType.YouTube when entry.ExternalSourceKey?.StartsWith("youtube:", StringComparison.Ordinal) == true =>
            $"YouTube: {entry.ExternalSourceKey[8..]}",
        _ => entry.ExternalSourceKey ?? "Externe Quelle"
    };

    private string GetHistoryVideoName(PlaybackHistory entry) => entry.SourceType switch
    {
        MediaSourceType.Local when entry.MediaId is int mediaId =>
            _videos.FirstOrDefault(video => video.Id == mediaId)?.FileName ?? $"Video #{mediaId}",
        MediaSourceType.YouTube when entry.ExternalSourceKey?.StartsWith("youtube:", StringComparison.Ordinal) == true =>
            entry.ExternalSourceKey[8..],
        _ => entry.ExternalSourceKey ?? "Unbekannt"
    };

    private static string FormatHistoryStatus(PlaybackHistory entry) => entry switch
    {
        { Completed: true } => "Completed",
        { Interrupted: true } => "Interrupted",
        _ => "Error"
    };

    private static string FormatSegment(TimeSpan start, TimeSpan end) =>
        $"{start:hh\\:mm\\:ss} – {end:hh\\:mm\\:ss}";

    private static string FormatOrigin(QueueEntryOrigin origin) => origin switch
    {
        QueueEntryOrigin.ManualNext => "Manuell: Als Nächstes",
        QueueEntryOrigin.ManualNow => "Manuell: Sofort",
        QueueEntryOrigin.Manual => "Manuell",
        _ => "Automatisch"
    };

    private static string FormatNewsMode(NewsMode mode) => mode switch
    {
        NewsMode.SplitScreen => "Split-Screen",
        NewsMode.Fullscreen => "Fullscreen",
        _ => "Ticker"
    };
}
