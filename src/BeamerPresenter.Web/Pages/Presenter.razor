@page "/presenter"
@layout PresenterLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<div class="presenter-screen" id="presenter-root">
    <video id="presenter-video" preload="auto" playsinline></video>
    <div class="presenter-idle" id="presenter-idle">
        <div class="presenter-pulse"><span></span></div>
        <p class="presenter-eyebrow">BEAMER PRESENTER</p>
        <h1>Warte auf das nächste Video</h1>
        <p id="presenter-status">Echtzeitverbindung wird hergestellt …</p>
    </div>
</div>

<script src="_content/BeamerPresenter.Web/js/presenter.js"></script>
