@page "/presenter"
@layout PresenterLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<div class="presenter-screen" id="presenter-root">
    <video id="presenter-video" preload="auto" playsinline></video>
    <div id="presenter-youtube-host" class="presenter-youtube presenter-media-hidden" aria-label="YouTube-Wiedergabe"></div>
    <section id="presenter-news" class="presenter-news presenter-media-hidden" aria-live="polite">
        <p id="presenter-news-title" class="presenter-news-title"></p>
        <p id="presenter-news-text" class="presenter-news-text"></p>
    </section>
    <section id="presenter-ticker" class="presenter-ticker presenter-media-hidden" aria-live="polite">
        <p id="presenter-ticker-title" class="presenter-ticker-title"></p>
        <p id="presenter-ticker-text" class="presenter-ticker-text"></p>
    </section>
    <div class="presenter-idle" id="presenter-idle">
        <div class="presenter-pulse"><span></span></div>
        <p class="presenter-eyebrow">BEAMER PRESENTER</p>
        <h1>Warte auf das nächste Video</h1>
        <p id="presenter-status">Echtzeitverbindung wird hergestellt …</p>
    </div>
</div>

<script src="_content/BeamerPresenter.Web/js/presenter.js"></script>
