<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  <Version>0.4.0</Version></PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <InternalsVisibleTo Include="BeamerPresenter.App.Tests" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <ProjectReference Include="..\BeamerPresenter.Infrastructure\BeamerPresenter.Infrastructure.csproj" />
    <ProjectReference Include="..\BeamerPresenter.Web\BeamerPresenter.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\BeamerPresenter.Web\wwwroot\**\*">
      <Link>wwwroot\_content\BeamerPresenter.Web\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(NuGetPackageRoot)mudblazor\9.10.0\staticwebassets\**\*">
      <Link>wwwroot\_content\MudBlazor\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
